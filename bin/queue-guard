#!/usr/bin/env php
<?php

declare(strict_types=1);

$autoloadPaths = [
    __DIR__ . '/../vendor/autoload.php',
    __DIR__ . '/../../../autoload.php',
];

$loaded = false;
foreach ($autoloadPaths as $autoload) {
    if (file_exists($autoload)) {
        require_once $autoload;
        $loaded = true;
        break;
    }
}

if (! $loaded) {
    fwrite(STDERR, "Composer autoload not found. Run 'composer install' first.\n");
    exit(1);
}

use Malikad\QueueGuard\Console\AnalyseCommand;
use Malikad\QueueGuard\Console\BaselineCommand;
use Malikad\QueueGuard\Console\ExplainCommand;
use Malikad\QueueGuard\Console\InitCommand;
use Malikad\QueueGuard\Console\ListRulesCommand;
use Malikad\QueueGuard\QueueGuard;
use Symfony\Component\Console\Application;

$knownCommands = ['analyse', 'explain', 'init', 'baseline', 'list-rules', 'help', 'list'];
$argv = isset($_SERVER['argv']) && is_array($_SERVER['argv']) ? $_SERVER['argv'] : [];
if (isset($argv[1]) && is_string($argv[1]) && ! str_starts_with($argv[1], '-') && ! in_array($argv[1], $knownCommands, true)) {
    array_splice($argv, 1, 0, ['analyse']);
    $_SERVER['argv'] = $argv;
}

$app = new Application('laravel-queue-guard', QueueGuard::VERSION);
$app->addCommands([
    new AnalyseCommand(),
    new ExplainCommand(),
    new InitCommand(),
    new BaselineCommand(),
    new ListRulesCommand(),
]);
$app->setDefaultCommand('analyse');

exit($app->run());
