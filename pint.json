{
    "preset": "laravel",
    "exclude": [
        "i.php",
        "build-zip.php",
        "verify-zip.php"
    ],
    "rules": {
        "declare_strict_types": true,
        "single_quote": true,
        "no_unused_imports": true,
        "ordered_imports": {
            "sort_algorithm": "alpha"
        }
    }
}
